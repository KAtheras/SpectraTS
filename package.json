{
  "name": "timesheet-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check": "node scripts/check-syntax.js",
    "dev": "node server.js",
    "dev:netlify": "netlify dev",
    "dev:offline": "HOME=/tmp XDG_CONFIG_HOME=/tmp netlify dev --offline",
    "start": "node server.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:seed:acme-analytics": "node --env-file-if-exists=.env scripts/seed-acme-analytics.js",
    "test": "npm run check && npm run test:unit",
    "test:unit": "node tests/permissions.test.js && node tests/themePreferences.test.js && node tests/analyticsOptions.test.js && node tests/acmeAnalyticsSeed.test.js && node tests/recordsPagination.test.js",
    "test:integration": "node --env-file-if-exists=.env tests/mutations.test.js",
    "version:assets": "node scripts/update-asset-version.js",
    "build": "npm run version:assets"
  },
  "dependencies": {
    "@netlify/neon": "^0.1.2",
    "resend": "^6.9.4"
  },
  "devDependencies": {
    "netlify-cli": "^24.9.0"
  }
}
